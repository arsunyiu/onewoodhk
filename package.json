{
  "name": "onewood-crm",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --d1=onewood-crm-production --local --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name onewood-crm",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl -s http://localhost:3000",
    "db:migrate:local": "wrangler d1 migrations apply onewood-crm-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply onewood-crm-production",
    "db:seed": "wrangler d1 execute onewood-crm-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "db:console:local": "wrangler d1 execute onewood-crm-production --local",
    "db:console:prod": "wrangler d1 execute onewood-crm-production"
  },
  "dependencies": {
    "hono": "^4.12.30"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
