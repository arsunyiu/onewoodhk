{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yimu-crm",
  "compatibility_date": "2026-07-10",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yimu-crm-production",
      "database_id": "REPLACE_WITH_PRODUCTION_DATABASE_ID"
    }
  ]
}
