{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onewood-crm",
  "compatibility_date": "2026-07-10",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onewood-crm-production",
      "database_id": "REPLACE_WITH_PRODUCTION_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "onewood-crm-attachments"
    }
  ]
}
